# ==========================================
# RESTAURANT INVENTORY MANAGEMENT SYSTEM
# Environment Configuration Template
# ==========================================

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api

# --- Backend Configuration ---
PORT=5000
FRONTEND_URL=http://localhost:5173

# MySQL 8 Configuration (Transactional Source of Truth)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=restaurant_inventory_db

# MongoDB Configuration (Logs, Audit Trails, Operational Records)
MONGODB_URI=mongodb://localhost:27017/restaurant_inventory_logs

# --- Python Forecasting Service Configuration ---
FORECAST_SERVICE_PORT=8000
